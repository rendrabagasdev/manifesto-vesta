// use prisma-8

enum UserRole {
  @@type("pg/text@1")

  ADMIN    = "ADMIN"
  PRODUCER = "PRODUCER"
  WAREHOUSE = "WAREHOUSE"
  CONSUMER = "CONSUMER"
  BUSINESS = "BUSINESS"
}

enum BatchStatus {
  @@type("pg/text@1")

  FRESH    = "FRESH"
  RESCUE   = "RESCUE"
  FEED     = "FEED"
  RESIDUE  = "RESIDUE"
  DISPOSED = "DISPOSED"
}

enum ProductCategory {
  @@type("pg/text@1")

  VEGETABLE = "VEGETABLE"
  FRUIT     = "FRUIT"
  PROTEIN   = "PROTEIN"
  STAPLE    = "STAPLE"
  HERB      = "HERB"
  OTHER     = "OTHER"
}

enum TierName {
  @@type("pg/text@1")

  STARTER  = "STARTER"
  SILVER   = "SILVER"
  GOLD     = "GOLD"
  PLATINUM = "PLATINUM"
}

enum LedgerType {
  @@type("pg/text@1")

  EARN   = "EARN"
  REDEEM = "REDEEM"
  ADJUST = "ADJUST"
}

enum WalletTransactionType {
  @@type("pg/text@1")

  CREDIT = "CREDIT"
  DEBIT  = "DEBIT"
}

enum WalletTransactionSource {
  @@type("pg/text@1")

  ORDER      = "ORDER"
  WITHDRAWAL = "WITHDRAWAL"
  ADJUSTMENT = "ADJUSTMENT"
}

enum WithdrawalStatus {
  @@type("pg/text@1")

  PENDING  = "PENDING"
  APPROVED = "APPROVED"
  REJECTED = "REJECTED"
}

enum OrderStatus {
  @@type("pg/text@1")

  PENDING   = "PENDING"
  PAID      = "PAID"
  SHIPPED   = "SHIPPED"
  COMPLETED = "COMPLETED"
  CANCELLED = "CANCELLED"
}

enum OrderKind {
  @@type("pg/text@1")

  REGULAR  = "REGULAR"
  PREORDER = "PREORDER"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  username     String?
  name         String?
  phone        String?
  city         String?
  address      String?
  passwordHash String
  role         UserRole
  posts        Post[]
  producer     Producer?
  warehouses   Warehouse[]
  buyerTier    BuyerTier?
  orders       Order[]
  loyaltyLedger LoyaltyLedger[]
  rescueQuotaUsages RescueQuotaUsage[]
  cascadeEvents CascadeEvent[]
  walletTransactions    WalletTransaction[]
  withdrawalsRequested  WithdrawalRequest[] @relation("WithdrawalRequester")
  withdrawalsReviewed   WithdrawalRequest[] @relation("WithdrawalReviewer")
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  author    User     @relation(fields: [authorId], references: [id])
  authorId  Int
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Producer {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  farmName  String
  address   String?
  phone     String?
  latitude  Float?
  longitude Float?
  products  Product[]
  wallet    ProducerWallet?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Warehouse {
  id         Int      @id @default(autoincrement())
  name       String
  address    String?
  city       String?
  latitude   Float?
  longitude  Float?
  capacityKg Float
  managerId  Int?
  manager    User?    @relation(fields: [managerId], references: [id])
  batches    Batch[]
  createdAt  TimestamptzString @default(now())
  updatedAt  temporal.updatedAtString()

  @@index([managerId])
}

model Product {
  id             Int             @id @default(autoincrement())
  producerId     Int
  producer       Producer        @relation(fields: [producerId], references: [id], onDelete: Cascade)
  name           String
  category       ProductCategory
  unit           String          @default("kg")
  shelfLifeDays  Int
  idealTempC     Float
  basePricePerKg Int
  description    String?
  imageUrl       String?
  batches        Batch[]
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()

  @@index([producerId])
  @@index([category])
}

model Batch {
  id                Int           @id @default(autoincrement())
  code              String        @unique
  productId         Int
  product           Product       @relation(fields: [productId], references: [id])
  warehouseId       Int
  warehouse         Warehouse     @relation(fields: [warehouseId], references: [id])
  harvestDate       DateString
  receivedAt        TimestamptzString @default(now())
  storageTempC      Float
  quantityKg        Float
  reservedKg        Float         @default(0)
  freshnessScore    Float         @default(100)
  status            BatchStatus   @default(FRESH)
  qualityNote       String?
  isManuallyAdjusted Boolean      @default(false)
  priceBreakdown    PriceBreakdown?
  cascadeEvents     CascadeEvent[]
  rescueDeal        RescueDeal?
  feedListing       FeedListing?
  residueListing    ResidueListing?
  orderItems        OrderItem[]
  impactLogs        ImpactLog[]
  createdAt         TimestamptzString @default(now())
  updatedAt         temporal.updatedAtString()

  @@index([productId])
  @@index([warehouseId])
  @@index([status])
}

model PriceBreakdown {
  id                 Int      @id @default(autoincrement())
  batchId            Int      @unique
  batch              Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  basePricePerKg     Int
  warehouseCostPerKg Int      @default(0)
  logisticsCostPerKg Int      @default(0)
  marginPerKg        Int      @default(0)
  rescueDiscountPct  Float    @default(0)
  finalPricePerKg    Int
  createdAt          TimestamptzString @default(now())
  updatedAt          temporal.updatedAtString()
}

model CascadeEvent {
  id             Int          @id @default(autoincrement())
  batchId        Int
  batch          Batch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  fromStatus     BatchStatus?
  toStatus       BatchStatus
  freshnessScore Float
  reason         String?
  actorId        Int?
  actor          User?        @relation(fields: [actorId], references: [id])
  impactLogs     ImpactLog[]
  createdAt      TimestamptzString @default(now())

  @@index([batchId])
}

model BuyerTier {
  id                 Int       @id @default(autoincrement())
  userId             Int       @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier               TierName  @default(STARTER)
  totalSpend30d      Int       @default(0)
  points             Int       @default(0)
  rescueQuotaPerWeek Int       @default(2)
  earlyAccessHours   Int       @default(0)
  createdAt          TimestamptzString @default(now())
  updatedAt          temporal.updatedAtString()

  @@index([tier])
}

model LoyaltyLedger {
  id          Int        @id @default(autoincrement())
  userId      Int
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId     Int?
  order       Order?     @relation(fields: [orderId], references: [id])
  type        LedgerType
  amount      Int
  pointsDelta Int        @default(0)
  description String?
  createdAt   TimestamptzString @default(now())

  @@index([userId])
}

model RescueQuotaUsage {
  id        Int    @id @default(autoincrement())
  userId    Int
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart DateString
  used      Int    @default(0)
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@unique([userId, weekStart])
}

model RescueDeal {
  id               Int      @id @default(autoincrement())
  batchId          Int      @unique
  batch            Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  discountPct      Float
  rescuePricePerKg Int
  startsAt         TimestamptzString
  endsAt           TimestamptzString
  earlyAccessHours Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        TimestamptzString @default(now())
  updatedAt        temporal.updatedAtString()

  @@index([isActive])
}

model FeedListing {
  id          Int      @id @default(autoincrement())
  batchId     Int      @unique
  batch       Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  pricePerKg  Int
  availableKg Float
  suitableFor String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  @@index([isActive])
}

model ResidueListing {
  id             Int      @id @default(autoincrement())
  batchId        Int      @unique
  batch          Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  pricePerKg     Int
  availableKg    Float
  processingType String?
  description    String?
  isActive       Boolean  @default(true)
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()

  @@index([isActive])
}

model ProducerWallet {
  id             Int      @id @default(autoincrement())
  producerId     Int      @unique
  producer       Producer @relation(fields: [producerId], references: [id], onDelete: Cascade)
  /// Available rupiah balance. The wallet transaction ledger is the source of
  /// truth; this column is always updated inside the same transaction that
  /// appends a ledger row.
  balance        Int      @default(0)
  /// Cumulative rupiah already paid out through approved withdrawals.
  withdrawnTotal Int      @default(0)
  transactions   WalletTransaction[]
  withdrawals    WithdrawalRequest[]
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()
}

model WalletTransaction {
  id           Int                     @id @default(autoincrement())
  walletId     Int
  wallet       ProducerWallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type         WalletTransactionType
  source       WalletTransactionSource @default(ADJUSTMENT)
  /// Signed rupiah delta: positive for CREDIT, negative for DEBIT.
  amount       Int
  balanceAfter Int
  /// Idempotency key within one wallet, e.g. `ORDER-ORD-...-code` or a
  /// withdrawal code. Unique per [wallet, source, reference] so a replayed
  /// payment webhook cannot credit the same order twice.
  reference    String?
  description  String?
  actorId      Int?
  actor        User?                   @relation(fields: [actorId], references: [id])
  createdAt    TimestamptzString @default(now())

  @@unique([walletId, source, reference])
  @@index([walletId])
}

model WithdrawalRequest {
  id                Int                        @id @default(autoincrement())
  walletId          Int
  wallet            ProducerWallet             @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount            Int
  status            WithdrawalStatus           @default(PENDING)
  bankName          String
  bankAccountName   String
  bankAccountNumber String
  note              String?
  decisionNote      String?
  requestedById     Int
  requestedBy       User                       @relation("WithdrawalRequester", fields: [requestedById], references: [id])
  reviewedById      Int?
  reviewedBy        User?                      @relation("WithdrawalReviewer", fields: [reviewedById], references: [id])
  reviewedAt        TimestamptzString?
  /// WalletTransaction.id created when the admin approved the payout.
  transactionId     Int?
  createdAt         TimestamptzString @default(now())
  updatedAt         temporal.updatedAtString()

  @@index([walletId])
  @@index([status])
}

model Order {
  id              Int         @id @default(autoincrement())
  code            String      @unique
  buyerId         Int
  buyer           User        @relation(fields: [buyerId], references: [id])
  kind            OrderKind   @default(REGULAR)
  status          OrderStatus @default(PENDING)
  subtotal        Int
  discount        Int         @default(0)
  shippingCost    Int         @default(0)
  total           Int
  tierAtPurchase  TierName    @default(STARTER)
  deliveryAddress String?
  deliveryCity    String?
  deliveryMethod  String?
  estimatedDeliveryAt TimestamptzString?
  deliveryLatitude       Float?
  deliveryLongitude      Float?
  deliveryDistanceKm     Float?
  deliveryDurationMinutes Int?
  contactPhone    String?
  scheduledFor    DateString?
  notes           String?
  paymentProvider String?
  paymentRef      String?
  paymentUrl      String?
  paidAt          TimestamptzString?
  items           OrderItem[]
  loyaltyLedger   LoyaltyLedger[]
  impactLogs      ImpactLog[]
  createdAt       TimestamptzString @default(now())
  updatedAt       temporal.updatedAtString()

  @@index([buyerId])
  @@index([status])
  @@index([kind])
  @@index([buyerId, kind])
}

model OrderItem {
  id         Int         @id @default(autoincrement())
  orderId    Int
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  batchId    Int
  batch      Batch       @relation(fields: [batchId], references: [id])
  quantityKg Float
  pricePerKg Int
  lineTotal  Int
  stage      BatchStatus
  createdAt  TimestamptzString @default(now())

  @@unique([orderId, batchId])
  @@index([batchId])
}

/// Single-row table (id = 1) holding the operational knobs an ADMIN can tune
/// without a redeploy: cascade thresholds, stage timers and default costs.
model PlatformConfig {
  id                       Int      @id @default(1)
  thresholdFresh           Int      @default(70)
  thresholdRescue          Int      @default(30)
  thresholdFeed            Int      @default(10)
  thresholdResidue         Int      @default(0)
  freshTimerHours          Int?
  rescueTimerHours         Int?
  feedTimerHours           Int?
  residueTimerHours        Int?
  rescueDealDurationHours  Int      @default(48)
  earlyAccessWindowHours   Int      @default(12)
  warehouseCostPerKg       Int      @default(1000)
  logisticsCostPerKg       Int      @default(1500)
  marginPerKg              Int      @default(2000)
  updatedById              Int?
  createdAt                TimestamptzString @default(now())
  updatedAt                temporal.updatedAtString()
}

model ImpactLog {
  id               Int           @id @default(autoincrement())
  batchId          Int?
  batch            Batch?        @relation(fields: [batchId], references: [id])
  orderId          Int?
  order            Order?        @relation(fields: [orderId], references: [id])
  cascadeEventId   Int?
  cascadeEvent     CascadeEvent? @relation(fields: [cascadeEventId], references: [id])
  rescuedKg        Float         @default(0)
  co2eSavedKg      Float         @default(0)
  waterSavedLiters Float         @default(0)
  wasteDivertedKg  Float         @default(0)
  createdAt        TimestamptzString @default(now())

  @@index([batchId])
}
