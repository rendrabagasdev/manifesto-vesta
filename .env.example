# Database (PostgreSQL - Supabase or Neon)
DATABASE_URL="postgresql://postgres:postgres@db.your-project.supabase.co:5432/postgres"

# Auth
NEXTAUTH_SECRET="your-super-secret-key-min-32-chars"
NEXTAUTH_URL="https://your-domain.vercel.app"

# Supabase (optional - for auth and realtime)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Scheduler
CRON_SECRET="replace-with-a-long-random-secret"

# Payment Sandbox (Midtrans)
MIDTRANS_SERVER_KEY="SERVER-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
MIDTRANS_CLIENT_KEY="KEY-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# WhatsApp Sandbox (Fonnte)
FONNTE_API_TOKEN="your-fonnte-api-token-here"

# Demo Controls
SIMULATE_TIME_ENABLED="true"

# Maintenance Mode Settings (proxy.ts)
# Set ke "true" untuk mengaktifkan pemeliharaan dan redirect otomatis
MAINTENANCE_MODE="false"
MAINTENANCE_BYPASS_KEY="vesta2026"